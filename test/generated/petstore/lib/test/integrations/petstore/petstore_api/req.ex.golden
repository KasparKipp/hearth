defmodule Test.Integrations.Petstore.PetstoreApi.Req do
  @moduledoc """
  Req-based implementation of `Test.Integrations.Petstore.PetstoreApi`.

  Generated by Hearth. Each function delegates to the Layer 1
  client's `request/2`.
  """

  @behaviour Test.Integrations.Petstore.PetstoreApi

  alias Test.Integrations.Petstore

  @impl true
  def list_pets(opts \\ []) do
    Petstore.request("/pets", opts)
  end

  @impl true
  def create_pets(opts \\ []) do
    Petstore.request("/pets", [method: :post] ++ opts)
  end

  @impl true
  def show_pet_by_id(pet_id, opts \\ []) do
    Petstore.request("/pets/#{pet_id}", opts)
  end
end
