# This test drives `Req.Test` through Plug; it is active only when
# `plug` is loaded. To run it, add `{:plug, "~> 1.0"}` to your deps
# — for all environments, not `only: :test`: `req` declares `plug`
# as an optional all-environment dependency, and a narrower scope
# diverges from it.
if Code.ensure_loaded?(Plug.Conn) do
  defmodule Test.Integrations.TictactoeTest do
    @moduledoc false

    # Generated by Hearth — verifies the auth scheme wired into
    # Test.Integrations.Tictactoe attaches credentials at request time.
    # The tests double as examples of every way to supply the credential.
    # Hearth-owned: regenerated on every `mix hearth.gen` run.

    use ExUnit.Case, async: false

    @client Test.Integrations.Tictactoe
    @api_key "hearth-test-credential"

    setup do
      previous = Application.get_env(:test, @client, [])
      configure_api_key(@api_key)
      on_exit(fn -> Application.put_env(:test, @client, previous) end)
      :ok
    end

    # Sets `config :test, @client, api_key: value` for this test.
    defp configure_api_key(value) do
      config = Application.get_env(:test, @client, [])
      Application.put_env(:test, @client, Keyword.put(config, :api_key, value))
    end

    # Any `{module, function, args}` works as a credential — e.g. a vault
    # lookup. Called when each request runs.
    def fetch_api_key, do: "from-mfa"

    test "request! attaches a bearer token from config" do
      plug = fn conn ->
        assert Plug.Conn.get_req_header(conn, "authorization") == ["Bearer #{@api_key}"]
        Plug.Conn.send_resp(conn, 200, JSON.encode!(%{}))
      end

      assert %Req.Response{status: 200} = @client.request!("/ping", plug: plug)
    end

    test "config api_key: may be a 0-arity function, resolved per request" do
      configure_api_key(fn -> "from-function" end)

      plug = fn conn ->
        assert Plug.Conn.get_req_header(conn, "authorization") == ["Bearer from-function"]
        Plug.Conn.send_resp(conn, 200, JSON.encode!(%{}))
      end

      assert %Req.Response{status: 200} = @client.request!("/ping", plug: plug)
    end

    test "config api_key: may be an {m, f, a} tuple" do
      configure_api_key({__MODULE__, :fetch_api_key, []})

      plug = fn conn ->
        assert Plug.Conn.get_req_header(conn, "authorization") == ["Bearer from-mfa"]
        Plug.Conn.send_resp(conn, 200, JSON.encode!(%{}))
      end

      assert %Req.Response{status: 200} = @client.request!("/ping", plug: plug)
    end

    test "a per-call api_key: overrides config" do
      plug = fn conn ->
        assert Plug.Conn.get_req_header(conn, "authorization") == ["Bearer per-call"]
        Plug.Conn.send_resp(conn, 200, JSON.encode!(%{}))
      end

      assert %Req.Response{status: 200} =
               @client.request!("/ping", plug: plug, api_key: "per-call")
    end

    test "a per-call api_key: may be a function" do
      plug = fn conn ->
        assert Plug.Conn.get_req_header(conn, "authorization") == ["Bearer per-call-function"]
        Plug.Conn.send_resp(conn, 200, JSON.encode!(%{}))
      end

      assert %Req.Response{status: 200} =
               @client.request!("/ping", plug: plug, api_key: fn -> "per-call-function" end)
    end

    test "new/1 accepts api_key: too" do
      plug = fn conn ->
        assert Plug.Conn.get_req_header(conn, "authorization") == ["Bearer from-new"]
        Plug.Conn.send_resp(conn, 200, JSON.encode!(%{}))
      end

      assert %Req.Response{status: 200} =
               Req.request!(@client.new(url: "/ping", api_key: "from-new", plug: plug))
    end

    test "a credential set explicitly on the request wins" do
      plug = fn conn ->
        assert Plug.Conn.get_req_header(conn, "authorization") == ["Bearer explicit-credential"]
        Plug.Conn.send_resp(conn, 200, JSON.encode!(%{}))
      end

      assert %Req.Response{status: 200} =
               @client.request!("/ping", plug: plug, auth: {:bearer, "explicit-credential"})
    end
  end
end
