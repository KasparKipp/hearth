defmodule Test.Integrations.Tictactoe.TictactoeApi.Req do
  @moduledoc """
  Req-based implementation of `Test.Integrations.Tictactoe.TictactoeApi`.

  Generated by Hearth. Each function delegates to the Layer 1
  client's `request/2`.
  """

  @behaviour Test.Integrations.Tictactoe.TictactoeApi

  alias Test.Integrations.Tictactoe

  @impl true
  def get_board(opts \\ []) do
    Tictactoe.request("/board", opts)
  end

  @impl true
  def get_square(row, column, opts \\ []) do
    Tictactoe.request("/board/#{row}/#{column}", opts)
  end

  @impl true
  def put_square(row, column, opts \\ []) do
    Tictactoe.request("/board/#{row}/#{column}", [method: :put] ++ opts)
  end
end
