defmodule Test.Integrations.Tictactoe.TictactoeApi do
  @moduledoc """
  Behaviour for the Tictactoe HTTP integration.

  Generated by Hearth from an OpenAPI spec — one callback per
  operation. Business logic should depend on this behaviour rather
  than calling HTTP directly.

  ## Source

  * **Source:** `priv/specs/tictactoe-3.1.yaml`
  * **Title:** Tic Tac Toe
  * **Version:** 1.0.0
  * **OpenAPI:** 3.1.0

  This API allows writing down marks on a Tic Tac Toe board
  and requesting the state of the board or of individual squares.
  """

  @otp_app :test

  @callback get_board(opts :: keyword()) :: {:ok, Req.Response.t()} | {:error, Exception.t()}

  @doc """
  Get the whole board

  Retrieves the current state of the board and the winner.
  """
  def get_board(opts \\ []), do: impl().get_board(opts)

  @callback get_square(row :: String.t(), column :: String.t(), opts :: keyword()) ::
              {:ok, Req.Response.t()} | {:error, Exception.t()}

  @doc """
  Get a single board square

  Retrieves the requested square.
  """
  def get_square(row, column, opts \\ []), do: impl().get_square(row, column, opts)

  @callback put_square(row :: String.t(), column :: String.t(), opts :: keyword()) ::
              {:ok, Req.Response.t()} | {:error, Exception.t()}

  @doc """
  Set a single board square

  Places a mark on the board and retrieves the whole board and the winner (if any).
  """
  def put_square(row, column, opts \\ []), do: impl().put_square(row, column, opts)

  defp impl, do: Application.get_env(@otp_app, __MODULE__, [])[:impl] || __MODULE__.Req
end
