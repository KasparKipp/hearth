# This test drives `Req.Test` through Plug; it is active only when
# `plug` is loaded. To run it, add `{:plug, "~> 1.0"}` to your deps
# — for all environments, not `only: :test`: `req` declares `plug`
# as an optional all-environment dependency, and a narrower scope
# diverges from it.
if Code.ensure_loaded?(Plug.Conn) do
  defmodule Test.Integrations.TenantedTest do
    @moduledoc false

    # Generated by Hearth — verifies the auth scheme wired into
    # Test.Integrations.Tenanted attaches credentials at request time.
    # The tests double as examples of every way to supply the credential.
    # Hearth-owned: regenerated on every `mix hearth.gen` run.

    use ExUnit.Case, async: false

    @client Test.Integrations.Tenanted
    @api_key "hearth-test-credential"

    # Values Layer 1 takes per call, never from config.
    @opts [
      api_key: @api_key,
      tenant_id: "hearth-test-tenant_id",
      headers: [{"x-region", "hearth-test-x-region"}],
      base_url: "http://hearth.test"
    ]

    setup do
      previous = Application.get_env(:test, @client, [])
      Application.put_env(:test, @client, Keyword.merge(previous, app_key: "hearth-test-app_key"))
      on_exit(fn -> Application.put_env(:test, @client, previous) end)
      :ok
    end

    # Without `api_key:`, MyApp.Tenancy.token/1 resolves the credential —
    # it's yours to test.
    test "request! sets the api_key query param from the api_key: option" do
      plug = fn conn ->
        conn = Plug.Conn.fetch_query_params(conn)
        assert conn.query_params["api_key"] == @api_key
        Plug.Conn.send_resp(conn, 200, JSON.encode!(%{}))
      end

      assert %Req.Response{status: 200} = @client.request!("/ping", @opts ++ [plug: plug])
    end

    test "a per-call api_key: may be a function" do
      plug = fn conn ->
        conn = Plug.Conn.fetch_query_params(conn)
        assert conn.query_params["api_key"] == "per-call-function"
        Plug.Conn.send_resp(conn, 200, JSON.encode!(%{}))
      end

      assert %Req.Response{status: 200} =
               @client.request!(
                 "/ping",
                 @opts ++ [plug: plug, api_key: fn -> "per-call-function" end]
               )
    end

    test "a credential set explicitly on the request wins" do
      plug = fn conn ->
        conn = Plug.Conn.fetch_query_params(conn)
        assert conn.query_params["api_key"] == "explicit-credential"
        Plug.Conn.send_resp(conn, 200, JSON.encode!(%{}))
      end

      assert %Req.Response{status: 200} =
               @client.request!(
                 "/ping",
                 @opts ++ [plug: plug, params: %{"api_key" => "explicit-credential"}]
               )
    end

    test "the key travels alongside the caller's params:" do
      plug = fn conn ->
        conn = Plug.Conn.fetch_query_params(conn)
        assert conn.query_params == %{"api_key" => @api_key, "limit" => "5"}
        Plug.Conn.send_resp(conn, 200, JSON.encode!(%{}))
      end

      assert %Req.Response{status: 200} =
               @client.request!("/ping", @opts ++ [plug: plug, params: [limit: 5]])
    end

    test "request! sets the x-app-key header from config" do
      plug = fn conn ->
        assert Plug.Conn.get_req_header(conn, "x-app-key") == ["hearth-test-app_key"]
        Plug.Conn.send_resp(conn, 200, JSON.encode!(%{}))
      end

      assert %Req.Response{status: 200} = @client.request!("/ping", @opts ++ [plug: plug])
    end

    test "a per-call app_key: overrides config" do
      plug = fn conn ->
        assert Plug.Conn.get_req_header(conn, "x-app-key") == ["per-call"]
        Plug.Conn.send_resp(conn, 200, JSON.encode!(%{}))
      end

      assert %Req.Response{status: 200} =
               @client.request!("/ping", @opts ++ [plug: plug, app_key: "per-call"])
    end

    test "an explicit x-app-key header wins" do
      plug = fn conn ->
        assert Plug.Conn.get_req_header(conn, "x-app-key") == ["explicit-credential"]
        Plug.Conn.send_resp(conn, 200, JSON.encode!(%{}))
      end

      assert %Req.Response{status: 200} =
               @client.request!(
                 "/ping",
                 @opts ++ [plug: plug, headers: [{"x-app-key", "explicit-credential"}]]
               )
    end

    test "request! sets the x-tenant-id header from the tenant_id: option" do
      plug = fn conn ->
        assert Plug.Conn.get_req_header(conn, "x-tenant-id") == ["hearth-test-tenant_id"]
        Plug.Conn.send_resp(conn, 200, JSON.encode!(%{}))
      end

      assert %Req.Response{status: 200} = @client.request!("/ping", @opts ++ [plug: plug])
    end

    test "without tenant_id:, request! raises" do
      plug = fn conn -> Plug.Conn.send_resp(conn, 200, JSON.encode!(%{})) end

      assert_raise RuntimeError, ~r/missing :tenant_id/, fn ->
        @client.request!("/ping", Keyword.delete(@opts, :tenant_id) ++ [plug: plug])
      end
    end

    test "an explicit x-tenant-id header wins" do
      plug = fn conn ->
        assert Plug.Conn.get_req_header(conn, "x-tenant-id") == ["explicit-credential"]
        Plug.Conn.send_resp(conn, 200, JSON.encode!(%{}))
      end

      assert %Req.Response{status: 200} =
               @client.request!(
                 "/ping",
                 @opts ++ [plug: plug, headers: [{"x-tenant-id", "explicit-credential"}]]
               )
    end

    # Without the header on the request, MyApp.Tenancy.region/1 resolves
    # x-region — it's yours to test.
    test "an explicit x-region header wins" do
      plug = fn conn ->
        assert Plug.Conn.get_req_header(conn, "x-region") == ["explicit-credential"]
        Plug.Conn.send_resp(conn, 200, JSON.encode!(%{}))
      end

      assert %Req.Response{status: 200} =
               @client.request!(
                 "/ping",
                 @opts ++ [plug: plug, headers: [{"x-region", "explicit-credential"}]]
               )
    end
  end
end
